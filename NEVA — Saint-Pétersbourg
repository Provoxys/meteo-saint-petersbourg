@layer base {
  html { background: var(--color-ink); color: var(--color-ice); }
  body { margin: 0px; min-height: 100vh; font-family: var(--font-sans); background: var(--color-ink); color: var(--color-ice); }
  button:not(:disabled), [role="button"]:not(:disabled) { cursor: pointer; }
}

.sky { background: var(--sky-top); transition: background 700ms; }

.sky-clear-day { --sky-top: linear-gradient(180deg, #d7e4ea 0%, #e7d3ae 42%, #7f9eae 100%); }

.sky-clear-night { --sky-top: linear-gradient(180deg, #070d14 0%, #142433 58%, #1c3344 100%); }

.sky-cloudy-day { --sky-top: linear-gradient(180deg, #8ea3b0 0%, #c5d0d6 55%, #6d8694 100%); }

.sky-cloudy-night { --sky-top: linear-gradient(180deg, #101820 0%, #24323c 100%); }

.sky-fog { --sky-top: linear-gradient(180deg, #c5d0d6 0%, #8d9aa3 100%); }

.sky-rain { --sky-top: linear-gradient(180deg, #1a303b 0%, #3d5564 100%); }

.sky-snow { --sky-top: linear-gradient(180deg, #e4eef3 0%, #9eb4c4 100%); }

.sky-storm { --sky-top: linear-gradient(180deg, #0c1218 0%, #243846 100%); }

.sky-white-night { --sky-top: linear-gradient(165deg, #d9c6e2 0%, #f0d7b0 46%, #7fa8bc 100%); }

.sky { background: var(--sky-top); }

.atmosphere { position: absolute; inset: 0px; overflow: hidden; pointer-events: none; }

.mote { position: absolute; top: -12%; width: 1px; height: 0.8rem; border-radius: 999px; background: var(--color-ice); opacity: 0.38; animation: auto linear 0s infinite normal none running fall; }

.atmosphere-snow .mote { width: 0.28rem; height: 0.28rem; opacity: 0.75; animation-duration: 9s; }

.atmosphere-storm .mote { opacity: 0.55; height: 1.1rem; }

.atmosphere-clear-night .mote { width: 2px; height: 2px; opacity: 0.8; animation-name: twinkle; background: var(--color-ice); }

.atmosphere-clear-night .mote:nth-child(4n) { background: var(--color-gold); }

.atmosphere-fog .mote, .atmosphere-cloudy-day .mote, .atmosphere-cloudy-night .mote, .atmosphere-clear-day .mote, .atmosphere-white-night .mote { width: 5rem; height: 5rem; border-radius: 999px; opacity: 0.14; background: radial-gradient(circle, var(--color-ice), transparent 70%); animation-name: drift-x; animation-duration: 16s; }

.atmosphere-white-night .mote { background: radial-gradient(circle, var(--color-gold), transparent 70%); }

@keyframes fall { 
  100% { transform: translate3d(var(--lean), 130vh, 0); }
}

@keyframes twinkle { 
  50% { opacity: 0.15; }
}

@keyframes drift-x { 
  50% { transform: translate3d(var(--lean), 12px, 0); }
}

.sun-disc, .moon-disc { position: absolute; border-radius: 999px; pointer-events: none; }

.sun-disc { top: 12%; right: 12%; width: 5.5rem; height: 5.5rem; background: radial-gradient(circle, rgb(255, 246, 228) 0%, rgb(231, 201, 138) 45%, rgba(231, 201, 138, 0) 72%); animation: 14s ease-in-out 0s infinite normal none running drift; }

.moon-disc { top: 14%; right: 14%; width: 3.25rem; height: 3.25rem; background: radial-gradient(circle at 35% 35%, rgb(247, 244, 238), rgb(212, 180, 131) 62%, transparent 64%); box-shadow: rgba(212, 180, 131, 0.35) 0px 0px 2.5rem; }

.neva-sheen { position: absolute; right: 0px; bottom: 22%; left: 0px; height: 18%; pointer-events: none; background: linear-gradient(90deg, transparent, rgba(231, 240, 244, 0.2), transparent); opacity: 0.55; animation: 9s ease-in-out 0s infinite normal none running sheen; }

.hero-scrim { background: linear-gradient(rgba(14, 22, 28, 0.05) 0%, rgba(14, 22, 28, 0.25) 42%, rgba(14, 22, 28, 0.82) 100%); pointer-events: none; }

.live-dot { width: 0.45rem; height: 0.45rem; border-radius: 999px; background: var(--color-gold); box-shadow: rgba(212, 180, 131, 0.7) 0px 0px 0px 0px; animation: 2.2s ease-out 0s infinite normal none running live-pulse; }

.live-dot.is-off { background: var(--color-mist); animation: auto ease 0s 1 normal none running none; box-shadow: none; }

.compass { position: relative; width: var(--spacing-compass); height: var(--spacing-compass); border-radius: 999px; border: 1px solid var(--color-line); background: radial-gradient(circle, transparent 58%, rgba(212, 180, 131, 0.12) 59%, transparent 60%), var(--color-ink-soft); }

.compass-mark { position: absolute; font-size: 0.7rem; color: var(--color-mist); }

.compass-n { top: 0.4rem; left: 50%; transform: translateX(-50%); color: var(--color-gold); }

.compass-e { right: 0.45rem; top: 50%; transform: translateY(-50%); }

.compass-s { bottom: 0.4rem; left: 50%; transform: translateX(-50%); }

.compass-w { left: 0.45rem; top: 50%; transform: translateY(-50%); }

.compass-needle { position: absolute; left: 50%; top: 50%; width: 2px; height: 38%; border-radius: 999px; background: linear-gradient(var(--color-gold), transparent); transform-origin: center bottom; translate: -50% -100%; transition: rotate 600ms cubic-bezier(0.2, 0, 0, 1); }

.rise { animation: 640ms cubic-bezier(0.2, 0, 0, 1) 0s 1 normal both running rise; }

.rise-2 { animation-delay: 80ms; }

.rise-3 { animation-delay: 160ms; }

.rise-4 { animation-delay: 240ms; }

@keyframes rise { 
  0% { opacity: 0; transform: translateY(12px); filter: blur(4px); }
  100% { opacity: 1; transform: translateY(0px); filter: blur(0px); }
}

@keyframes live-pulse { 
  70% { box-shadow: transparent 0px 0px 0px 7px; }
  100% { box-shadow: transparent 0px 0px 0px 0px; }
}

@keyframes drift { 
  50% { transform: translateY(8px); }
}

@keyframes sheen { 
  50% { transform: translateX(6%); opacity: 0.8; }
}

@media (prefers-reduced-motion: reduce) {
  .atmosphere { visibility: hidden; }
  .rise, .live-dot, .sun-disc, .neva-sheen, .mote, .animate-pulse, .animate-spin { animation: auto ease 0s 1 normal none running none; }
  .compass-needle { transition: none; }
}

